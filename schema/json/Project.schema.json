{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project",
  "type": "object",
  "required": [
    "created",
    "id",
    "key",
    "name",
    "owners",
    "seq",
    "updated"
  ],
  "properties": {
    "created": {
      "type": "string"
    },
    "id": {
      "description": "Immutable ULID.",
      "type": "string"
    },
    "key": {
      "description": "Human-facing key, `^[A-Z][A-Z0-9]{1,7}$`, immutable in v1.",
      "type": "string"
    },
    "name": {
      "description": "Display name; renames freely.",
      "type": "string"
    },
    "owners": {
      "description": "Optional owner emails.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seq": {
      "description": "Mutation-log seq of the last change to this entity.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "updated": {
      "type": "string"
    }
  }
}
