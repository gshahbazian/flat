{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["server/src/schema.gen.ts"],
  "sortImports": true,
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true
}
